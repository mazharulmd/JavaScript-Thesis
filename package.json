{
  "name": "bac-thesis",
  "version": "1.0.0",
  "private": true,
  "description": "Automated detection of Broken Access Control vulnerabilities in REST APIs: a role-aware testing tool in JavaScript (thesis artifact).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "test-api",
    "cli-tool"
  ],
  "scripts": {
    "start:api": "npm --workspace test-api start",
    "seed:print": "node test-api/seeds/seed.js",
    "scan": "node cli-tool/src/cli.js scan --spec test-api/openapi.yaml --config cli-tool/config/example.config.yaml",
    "scan:baseline": "node cli-tool/src/cli.js scan --spec test-api/openapi.yaml --config cli-tool/config/example.config.yaml --status-only",
    "test": "node --test --test-concurrency=1 tests/unit/ tests/integration/",
    "test:unit": "node --test tests/unit/",
    "test:integration": "node --test --test-concurrency=1 tests/integration/",
    "evaluate": "node evaluation/benchmark.js",
    "evaluate:compare": "node evaluation/compare.js"
  }
}
