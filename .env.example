# Copy to .env for local runs. NEVER put real credentials here.
# All values below belong to the isolated, intentionally vulnerable benchmark only.

# --- Benchmark test API ---
PORT=3000
# Benchmark-only signing key. Used by the test API and (optionally) by the scanner
# to forge *expired* tokens for the JWT_EXPIRED check (grey-box testing).
JWT_SECRET=bench-only-insecure-secret-change-me
TOKEN_TTL_SECONDS=3600
# all | none | comma-separated flaw IDs (see test-api/src/flaws.js)
FLAWS=all
# Enables POST /__benchmark/reset (undocumented, not in the OpenAPI spec)
BENCHMARK_MODE=1

# --- Scanner ---
# Name of the env var the scanner reads the JWT secret from (see example.config.yaml)
BENCH_JWT_SECRET=bench-only-insecure-secret-change-me
